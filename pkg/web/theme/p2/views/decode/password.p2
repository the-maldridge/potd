{% extends "../../base.p2" %}

{% block title %}Decoded Password{% endblock %}

{% block content %}
<div class="grid-center">
  <div>
    <h1>Password</h1>
    <h3>The password has been resolved.</h3>
    <ol>
      {% for password in passwords %}
      <li>{{ password }}</li>
      {% endfor %}
    </ol>
  </div>
</div>
{% endblock %}
